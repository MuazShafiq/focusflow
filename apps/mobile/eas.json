{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://focusflow-api-pearl.vercel.app/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://focusflow-api-pearl.vercel.app/api"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
