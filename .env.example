# Express API
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/focusflow
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_ORIGIN=http://localhost:5173
SCHEDULER_URL=http://127.0.0.1:5001
SCHEDULER_SERVICE_TOKEN=replace-with-an-internal-service-token

# Web
VITE_API_URL=http://localhost:4000/api

# Mobile (use your computer's LAN IP for a physical device)
EXPO_PUBLIC_API_URL=http://localhost:4000/api
